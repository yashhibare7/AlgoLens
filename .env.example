# Copy to .env and fill in. docker compose reads this file automatically.
# Nothing here is required for local development with the dev profile.

# --- required outside local development ---
# HS256 signing key. Minimum 32 bytes; the backend refuses to start with anything shorter.
# Generate one:  openssl rand -base64 48
ALGOLENS_JWT_SECRET=change-me-to-at-least-32-bytes-of-random-data

# --- database (docker compose / postgres profile) ---
ALGOLENS_DB_PASSWORD=algolens

# --- optional: AI explanations ---
# Without a key the AI panel falls back to the built-in local explainer, free of charge.
# Get one at https://console.anthropic.com/
ANTHROPIC_API_KEY=
ALGOLENS_AI_MODEL=claude-opus-5
# low | medium | high | xhigh | max
ALGOLENS_AI_EFFORT=MEDIUM

# --- optional: behaviour flags ---
# Turn on to make credits actually refuse requests instead of only metering them.
ALGOLENS_CREDITS_ENFORCED=false
# Turn off to require an account before any code can be run.
ALGOLENS_ALLOW_ANONYMOUS_EXECUTION=true
ALGOLENS_CORS_ORIGINS=http://localhost:5173,http://localhost:3000
